[Unit]
Description=TWonder instance %i
After=jack.service network-online.target
Wants=network-online.target
Requires=jack.service
PartOf=twonders.target

[Service]
Type=notify
PrivateTmp=true
EnvironmentFile=/usr/local/etc/wonder/cluster.conf
ExecStart=@share_dir@/scripts/start_single_twonder.sh %i
LimitRTPRIO=95
LimitRTTIME=infinity
LimitMEMLOCK=infinity
Restart=always
RestartSec=20
